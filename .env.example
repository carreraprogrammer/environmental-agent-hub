# =============================================================================
# AGENT HUB - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Reemplazar valores placeholder con valores reales
# 3. NUNCA commitear .env (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CRITICAL: Active Model Selection
# Cambiar este valor para switch de modelo SIN modificar código
# Valores permitidos: openai-gpt4, openai-gpt4o, gemini, roboflow
# -----------------------------------------------------------------------------
CLASSIFIER_MODEL=openai-gpt4

# -----------------------------------------------------------------------------
# AI Provider API Keys
# -----------------------------------------------------------------------------
# OpenAI (REQUERIDO para MVP)
OPENAI_API_KEY=sk-...
OPENAI_TIMEOUT=10

# Google Gemini (OPCIONAL - Fase 2)
GOOGLE_API_KEY=...

# Roboflow Custom Model (OPCIONAL - Fase 2)
ROBOFLOW_API_KEY=...
ROBOFLOW_MODEL_ID=environmental-agent-hub/waste-classifier/1

# -----------------------------------------------------------------------------
# S3-Compatible Storage Configuration (Optional - for background image uploads)
# Images are uploaded asynchronously in background and do NOT block classification
# Retry: 3 attempts with exponential backoff (1s, 2s, 4s)
# Structure: {tenant}/{YYYY-MM-DD}/{trace_id}.jpg
#
# SUPPORTED SERVICES:
# - AWS S3 (default)
# - MinIO (local development - see README)
# - Cloudflare R2 (recommended for production)
# - DigitalOcean Spaces
# - Any S3-compatible storage
# -----------------------------------------------------------------------------

# OPTION 1: MinIO (Local Development - Docker)
# Start MinIO: docker run -d -p 9000:9000 -p 9001:9001 \
#   --name minio -e MINIO_ROOT_USER=minioadmin \
#   -e MINIO_ROOT_PASSWORD=minioadmin123 \
#   minio/minio server /data --console-address ":9001"
# Console: http://localhost:9001 (user: minioadmin, password: minioadmin123)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
S3_BUCKET=agent-hub-images-dev
AWS_ENDPOINT_URL=http://localhost:9000

# OPTION 2: Cloudflare R2 (Production - Recommended)
# Sign up: https://dash.cloudflare.com/sign-up
# R2 Dashboard → Create Bucket → Generate Access Keys
# FREE TIER: 10 GB storage/month, ZERO egress costs
# AWS_ACCESS_KEY_ID=your-r2-access-key-id
# AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
# AWS_REGION=auto
# S3_BUCKET=agent-hub-images-prod
# AWS_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# OPTION 3: AWS S3 (Original)
# AWS Console → IAM → Create Access Key
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION=us-east-1
# S3_BUCKET=agent-hub-images-prod
# AWS_ENDPOINT_URL=  # Leave empty for AWS S3

# OPTION 4: DigitalOcean Spaces
# DigitalOcean → Spaces → Generate API Key
# AWS_ACCESS_KEY_ID=your-spaces-key
# AWS_SECRET_ACCESS_KEY=your-spaces-secret
# AWS_REGION=nyc3
# S3_BUCKET=agent-hub-images
# AWS_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com

# -----------------------------------------------------------------------------
# Backend Rails API Integration
# -----------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:3000/api/v1
BACKEND_TIMEOUT=3
# Organization ID for catalog sync (required for authenticated endpoints)
BACKEND_ORGANIZATION_ID=your-organization-uuid-here
# Service account JWT token for authenticated endpoints (optional if endpoint is public)
BACKEND_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# CORS Configuration
# Formato: Lista separada por comas
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# -----------------------------------------------------------------------------
# Railway Deployment (Automático en Railway)
# -----------------------------------------------------------------------------
# PORT=8000  # Railway inyecta automáticamente
